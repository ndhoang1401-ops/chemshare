+# ─────────────────────────────────────────────────────────────
+# Nguyên Tố — Biến môi trường cho PRODUCTION (docker-compose.yml)
+#
+# Khác với .env.example (dùng cho `npm run dev` chạy trực tiếp trên máy
+# bạn) — file này dùng khi chạy TOÀN BỘ stack bằng Docker.
+#
+# Cách dùng:
+#   cp .env.production.example .env.production
+#   # điền giá trị thật vào .env.production
+#   docker compose --env-file .env.production up -d --build
+#
+# .env.production KHÔNG được commit lên git (đã có trong .gitignore,
+# cùng nhóm với .env).
+# ─────────────────────────────────────────────────────────────
+
+# --- Database ---
+# 3 biến này dựng nên DATABASE_URL thật bên trong docker-compose.yml (trỏ
+# vào service "db" nội bộ, không phải localhost) — không cần tự khai
+# DATABASE_URL ở đây.
+POSTGRES_USER=chemshare
+POSTGRES_PASSWORD=doi-thanh-mat-khau-manh-that-o-day
+POSTGRES_DB=chemshare
+
+# --- Auth — NextAuth/Auth.js ---
+# Tạo bằng lệnh: openssl rand -base64 32
+AUTH_SECRET=
+# QUAN TRỌNG: phải khớp CHÍNH XÁC domain công khai thật (vd.
+# https://nguyento.dev) — không phải localhost, không phải tên service
+# nội bộ Docker. Auth.js dùng giá trị này làm nguồn "origin đáng tin" cho
+# mọi redirect (đăng nhập xong quay lại trang cũ...); đặt sai domain thì
+# redirect sẽ âm thầm trỏ nhầm chỗ. Xem NEXTJS_NOTES.md mục 14.
+AUTH_URL=https://your-real-domain.com
+APP_URL=https://your-real-domain.com
+
+# --- Email — xác thực tài khoản & quên mật khẩu ---
+EMAIL_SERVER_HOST=smtp.example.com
+EMAIL_SERVER_PORT=587
+EMAIL_SERVER_USER=
+EMAIL_SERVER_PASSWORD=
+EMAIL_FROM="Nguyên Tố <no-reply@example.com>"
+
+# --- Lưu trữ file — Cloudflare R2 hoặc AWS S3 ---
+# TÙY CHỌN: để trống cả 4 dòng STORAGE_* bên dưới, hệ thống tự lưu file
+# vào volume Docker "chemshare_storage_local" (đã khai sẵn trong
+# docker-compose.yml). Muốn dùng cloud thì điền đủ, không cần sửa code.
+STORAGE_PROVIDER=
+STORAGE_ENDPOINT=
+STORAGE_REGION=auto
+STORAGE_BUCKET=chemshare-documents
+STORAGE_ACCESS_KEY_ID=
+STORAGE_SECRET_ACCESS_KEY=
+STORAGE_PUBLIC_URL=
+
+# --- Giới hạn upload ---
+UPLOAD_MAX_SIZE_MB=25
+
+# --- Rate limiting ---
+# Lưu ý: docker-compose.yml chạy Next.js trực tiếp trong container, KHÔNG
+# tự có reverse proxy phía trước → rate limit theo IP (lib/rate-limit.ts)
+# sẽ áp dụng CHUNG cho mọi người thay vì theo từng người, TRỪ KHI bạn đặt
+# thêm Nginx/Caddy/Cloudflare trước container này và nó set đúng header
+# X-Forwarded-For. Xem NEXTJS_NOTES.md mục 14 và 16.
+RATE_LIMIT_WINDOW_SECONDS=60
+RATE_LIMIT_MAX_REQUESTS=30
