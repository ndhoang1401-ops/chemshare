# Next.js build output (build lại từ đầu trong container)
.next/
out/

# node_modules cài lại trong container, không copy từ máy host
node_modules/

# Biến môi trường thật — KHÔNG BAO GIỜ đưa vào image. Giá trị thật truyền
# qua docker-compose.yml (env_file/environment) lúc container chạy.
.env
.env*.local

# Git, IDE, log
.git/
.gitignore
.vscode/
.idea/
*.log
npm-debug.log*

# Test, docs không cần trong image production
coverage/
*.test.*
*.spec.*

# File Docker chính nó không cần copy vào build context của chính nó
Dockerfile*
.dockerignore
docker-compose*.yml

# Markdown — trừ README (không ảnh hưởng runtime nhưng đỡ rác image)
ROADMAP.md
NEXTJS_NOTES.md
CLAUDE.md
AGENTS.md
